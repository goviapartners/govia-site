# Supabase — proyecto de Edgar (ver supabase/migrations/001_leads_whitepaper.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gate de go-live de /whitepaper-git — dejar en false hasta cerrar
# bloqueantes de spec-landing-whitepaper-git.md §5/§6 (PDF, copy, LPDP).
NEXT_PUBLIC_LANDING_LIVE=false

# Resend — entrega del whitepaper por email (spec §3, opción b).
# Server-only, sin prefijo NEXT_PUBLIC_. Cuenta directa en resend.com
# (Marketplace de Vercel exige plan pago $20+/mes, se descartó por Zero-CapEx).
RESEND_API_KEY=
# Mientras goviapartners.com no esté verificado en Resend, DEBE ser
# onboarding@resend.dev (sandbox — solo entrega a la dirección de la cuenta
# Resend). Cambiar a algo en @goviapartners.com tras verificar el dominio.
RESEND_FROM_EMAIL=Govia Partners <onboarding@resend.dev>

# URL del PDF (Vercel Blob privado o Supabase Storage con link firmado).
# Server-only. Vacío mientras el whitepaper esté en redacción — el email
# sale igual, avisando que el PDF está en camino.
WHITEPAPER_DOWNLOAD_URL=

# Gate de go-live de /trust-maturity-score — dejar en false hasta aplicar
# la migración supabase/migrations/003_tms_assessments.sql en prod y dar
# el visto bueno a la copy de consentimiento (mismo patrón que
# NEXT_PUBLIC_LANDING_LIVE arriba).
NEXT_PUBLIC_ASSESSMENT_LIVE=false

# CTA de resultado del TMS ("Solicitar Trust Cartography"). Público — usado
# tanto en el cliente (botón) como en el email de resultados (server).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/goviapartners/trust-cartography

# Sección "También en el portafolio" del home → CTA a FlowPrep (producto de
# certificación CDMP, repo goviapartners/flowprep-data). Sin dominio propio
# todavía: usa la URL de Vercel mientras tanto. Cuando flowprepdata.com (o
# el dominio que se elija) esté apuntado, cambiar solo esta variable en
# Vercel — no requiere tocar código ni redeploy de este archivo.
NEXT_PUBLIC_FLOWPREP_URL=https://flowprep-data.vercel.app
